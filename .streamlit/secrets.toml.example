# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 값을 채웁니다. (secrets.toml 은 Git 에 올리지 않음)
# Streamlit Cloud 에서는 앱 설정 → Secrets 에 같은 내용을 붙여 넣습니다.

OPENAI_API_KEY = "sk-..."          # 연상 질문 · 코드 없는 질문 답변 (gpt-4o-mini)

[tidb]                             # 없으면 data/local_chat.db (SQLite) 로 동작
host = "gateway01.<region>.prod.aws.tidbcloud.com"
port = 4000
user = "<prefix>.root"
password = "<password>"
database = "migration_chat"        # 미리 만들어 둔 데이터베이스 이름
